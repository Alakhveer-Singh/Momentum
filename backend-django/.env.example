# Copy to .env and adjust. Settings read these (extend settings.py with os.environ as needed).

# Core — required in production, safe dev defaults if unset.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
SITE_URL=http://localhost:8000

# Database — set USE_MYSQL=1 to use MySQL instead of the default SQLite.
USE_MYSQL=
DB_NAME=quibus_django
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Production-only hardening (leave unset for local dev).
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CSRF_COOKIE_SECURE=False
